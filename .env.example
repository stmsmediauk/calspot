# Supabase project settings (Project Settings, API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose or commit. Needed later for trusted server actions.
SUPABASE_SERVICE_ROLE_KEY=

# The public address, for canonical links, the sitemap and share images (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Cloudflare Turnstile CAPTCHA on the booking form. Leave blank to keep it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
